<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>OGCONS Study Hub - Admin Notes</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f4f6f8;
    color:#222;
}

header{
    background:linear-gradient(135deg,#0066cc,#00a86b);
    color:white;
    padding:18px 25px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:10px;
}

header h1{
    margin:0;
    font-size:22px;
}

.back-btn{
    border:0;
    background:white;
    color:#0066cc;
    padding:10px 16px;
    border-radius:8px;
    font-weight:bold;
    cursor:pointer;
}

.container{
    max-width:1500px;
    margin:auto;
    padding:25px;
}

.card{
    background:white;
    padding:20px;
    margin-bottom:22px;
    border-radius:14px;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.card h2{
    margin-top:0;
    color:#0066cc;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
    margin-bottom:15px;
}

label{
    display:block;
    font-weight:bold;
    margin-bottom:7px;
}

select,
input[type="text"]{
    width:100%;
    padding:12px;
    border:1px solid #ccc;
    border-radius:8px;
    font-size:15px;
}

.toolbar{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    background:#eef2f5;
    border:1px solid #d5dce3;
    padding:10px;
    border-radius:9px 9px 0 0;
}

.toolbar button,
.toolbar select{
    width:auto;
    padding:7px 10px;
    border:1px solid #c8d0d8;
    background:white;
    border-radius:6px;
    cursor:pointer;
}

.toolbar button:hover{
    background:#e7f1ff;
}

#content{
    position:relative;
    width:100%;
    min-height:700px;
    padding:25px;
    border:1px solid #d5dce3;
    border-top:0;
    border-radius:0 0 9px 9px;
    background:white;
    overflow:auto;
    outline:none;
}

#content img{
    max-width:100%;
    height:auto;
}

/* ===================================
   DESIGN OBJECT
=================================== */

.design-object{
    position:absolute;
    box-sizing:border-box;
    user-select:none;
    touch-action:none;
}

.design-object.selected{
    outline:2px solid #0066cc;
    outline-offset:2px;
}

/* ===================================
   TEXT BOX
=================================== */

.text-object{
    min-width:100px;
    min-height:45px;
    padding:8px;
    border:1px solid transparent;
    background:transparent;
    cursor:move;
}

.text-object.selected{
    border:1px dashed #0066cc;
}

.text-object.editing{
    background:white;
    border:1px solid #0066cc;
    cursor:text;
    user-select:text;
    touch-action:auto;
}

.text-content{
    width:100%;
    min-height:30px;
    outline:none;
    overflow-wrap:anywhere;
    word-break:break-word;
}

/* ===================================
   IMAGE
=================================== */

.image-object{
    cursor:move;
    overflow:visible;
}

.image-object img{
    display:block;
    width:100%;
    height:auto;
    max-width:100%;
    pointer-events:none;
}

/* ===================================
   SHAPES
=================================== */

.shape-object{
    cursor:move;
}

.shape-arrow,
.shape-line,
.shape-rectangle,
.shape-circle{
    width:100%;
    height:100%;
    position:relative;
}

.shape-arrow::before{
    content:"";
    position:absolute;
    left:5%;
    right:8%;
    top:50%;
    height:4px;
    background:#222;
    transform:translateY(-50%);
}

.shape-arrow::after{
    content:"";
    position:absolute;
    right:1%;
    top:50%;
    width:18px;
    height:18px;
    border-top:4px solid #222;
    border-right:4px solid #222;
    transform:translateY(-50%) rotate(45deg);
}

.shape-line::before{
    content:"";
    position:absolute;
    left:0;
    right:0;
    top:50%;
    height:3px;
    background:#222;
    transform:translateY(-50%);
}

.shape-rectangle{
    border:3px solid #222;
}

.shape-circle{
    border:3px solid #222;
    border-radius:50%;
}

/* ===================================
   CONTROLS
=================================== */

.object-controls{
    position:absolute;
    left:0;
    top:-42px;
    display:flex;
    gap:4px;
    padding:4px;
    background:white;
    border:1px solid #ccc;
    border-radius:7px;
    box-shadow:0 3px 10px rgba(0,0,0,.15);
    z-index:1000;
}

.object-controls button{
    width:30px;
    height:28px;
    border:1px solid #ccc;
    background:white;
    border-radius:5px;
    cursor:pointer;
}

.resize-handle{
    position:absolute;
    width:12px;
    height:12px;
    right:-7px;
    bottom:-7px;
    background:#0066cc;
    border:2px solid white;
    border-radius:50%;
    cursor:nwse-resize;
    z-index:1001;
}

.rotation-handle{
    position:absolute;
    width:14px;
    height:14px;
    top:-35px;
    left:50%;
    transform:translateX(-50%);
    background:#00a86b;
    border:2px solid white;
    border-radius:50%;
    cursor:grab;
    z-index:1001;
}

.rotation-line{
    position:absolute;
    width:2px;
    height:28px;
    top:-27px;
    left:50%;
    transform:translateX(-50%);
    background:#00a86b;
}

/* ===================================
   BUTTONS
=================================== */

.actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top:15px;
}

.btn{
    border:0;
    padding:11px 18px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

.btn-primary{
    background:#0066cc;
    color:white;
}

.btn-success{
    background:#00a86b;
    color:white;
}

.btn-danger{
    background:#d62828;
    color:white;
}

.btn-secondary{
    background:#667085;
    color:white;
}

/* ===================================
   STATUS
=================================== */

#status{
    display:none;
    margin-top:12px;
    padding:10px;
    border-radius:7px;
}

#status.success{
    display:block;
    background:#e7f8ef;
    color:#087443;
}

#status.error{
    display:block;
    background:#fdecec;
    color:#a4161a;
}

/* ===================================
   SEARCH
=================================== */

.search-row{
    display:flex;
    gap:10px;
    margin-bottom:15px;
}

.search-row input{
    flex:1;
}

.note-count{
    color:#667085;
    font-size:14px;
    margin-bottom:15px;
}

.notes-list{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:15px;
}

.note-card{
    border:1px solid #ddd;
    border-radius:10px;
    padding:15px;
    background:white;
}

.note-card h3{
    margin:0 0 8px;
    color:#0066cc;
}

.note-topic{
    color:#667085;
    font-size:13px;
}

.note-preview{
    margin-top:10px;
    padding-top:10px;
    border-top:1px solid #eee;
    max-height:180px;
    overflow:hidden;
    overflow-wrap:anywhere;
}

.note-preview img{
    max-width:100%!important;
    height:auto!important;
}

.note-preview table{
    width:100%;
    border-collapse:collapse;
}

.note-preview td,
.note-preview th{
    border:1px solid #ccc;
    padding:5px;
}

.note-actions{
    display:flex;
    gap:8px;
    margin-top:12px;
}

.note-actions button{
    flex:1;
    border:0;
    padding:9px;
    border-radius:6px;
    cursor:pointer;
    font-weight:bold;
}

.edit-btn{
    background:#0066cc;
    color:white;
}

.delete-btn{
    background:#d62828;
    color:white;
}

/* ===================================
   PREVIEW
=================================== */

#previewBox{
    display:none;
}

#previewContent{
    padding:25px;
    border:1px solid #ddd;
    border-radius:10px;
    overflow-x:hidden;
}

#previewContent img{
    max-width:100%!important;
    height:auto!important;
}

/* ===================================
   SAVED NOTE CANVAS
=================================== */

.ogcons-note-canvas{
    position:relative;
    width:100%;
    max-width:100%;
    min-height:700px;
    box-sizing:border-box;
    overflow:visible;
}

.ogcons-note-canvas .design-object{
    position:absolute;
}

.ogcons-note-canvas .image-object img{
    width:100%!important;
    max-width:100%!important;
    height:auto!important;
}

.ogcons-note-canvas .text-object{
    max-width:90%;
    overflow-wrap:anywhere;
}

.ogcons-note-canvas .object-controls,
.ogcons-note-canvas .resize-handle,
.ogcons-note-canvas .rotation-handle,
.ogcons-note-canvas .rotation-line{
    display:none!important;
}

/* ===================================
   MOBILE
=================================== */

@media(max-width:700px){

    header{
        padding:15px;
    }

    header h1{
        font-size:18px;
    }

    .container{
        padding:12px;
    }

    .card{
        padding:14px;
    }

    .form-row{
        grid-template-columns:1fr;
    }

    #content{
        padding:15px;
    }

    .search-row{
        flex-direction:column;
    }

    .notes-list{
        grid-template-columns:1fr;
    }

    .ogcons-note-canvas{
        width:100%!important;
        max-width:100%!important;
    }

    .ogcons-note-canvas .text-object{
        max-width:92%;
    }
}

</style>
</head>

