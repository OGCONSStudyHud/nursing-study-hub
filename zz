/* =====================================================
   RESPONSIVE SAVE SYSTEM
===================================================== */

/*
    THIS IS THE IMPORTANT FIX.

    We use a fixed design coordinate width of 1000px.

    The saved canvas is always 1000 logical pixels wide,
    but CSS makes it shrink to the student's phone.

    Therefore:

       500px left  = 50%
       250px width = 25%

    Vertical position is kept in the same design
    coordinate system so an image does NOT jump
    to the bottom.
*/

const DESIGN_WIDTH = 1000;


/* =====================================================
   PREPARE HTML
===================================================== */

function prepareHTMLForSaving(){

    const editor =
        getEditor();


    const clone =
        editor.cloneNode(
            true
        );


    const originalObjects =
        Array.from(
            editor.querySelectorAll(
                ".design-object"
            )
        );


    const clonedObjects =
        Array.from(
            clone.querySelectorAll(
                ".design-object"
            )
        );


    originalObjects.forEach(
        function(original,index){

            const saved =
                clonedObjects[index];

            if(!saved){
                return;
            }


            /*
                Current editor width.
            */

            const editorWidth =
                Math.max(
                    editor.clientWidth,
                    1
                );


            /*
                Get original positions.
            */

            const left =
                parseFloat(
                    original.style.left
                ) || 0;

            const top =
                parseFloat(
                    original.style.top
                ) || 0;


            const width =
                original.offsetWidth ||
                parseFloat(
                    original.style.width
                ) ||
                200;


            /*
                Convert horizontal position
                to percentage.
            */

            const leftPercent =
                (
                    left /
                    editorWidth
                ) *
                100;


            const widthPercent =
                (
                    width /
                    editorWidth
                ) *
                100;


            /*
                SAVE LEFT RESPONSIVELY.
            */

            saved.style.left =
                leftPercent.toFixed(4) +
                "%";


            /*
                SAVE TOP AS PIXELS.

                This is the important correction.

                We don't convert vertical position
                into a percentage based on changing
                content height.
            */

            saved.style.top =
                Math.round(
                    top
                ) +
                "px";


            /*
                SAVE WIDTH RESPONSIVELY.
            */

            saved.style.width =
                widthPercent.toFixed(4) +
                "%";


            /*
                IMAGE
            */

            if(
                original.classList.contains(
                    "image-object"
                )
            ){

                saved.style.height =
                    "auto";

                const img =
                    saved.querySelector(
                        "img"
                    );

                if(img){

                    img.style.width =
                        "100%";

                    img.style.maxWidth =
                        "100%";

                    img.style.height =
                        "auto";

                }

            }


            /*
                TEXT BOX
            */

            if(
                original.classList.contains(
                    "text-object"
                )
            ){

                saved.style.height =
                    "auto";

                saved.style.maxWidth =
                    "90%";

                const text =
                    saved.querySelector(
                        ".text-content"
                    );

                if(text){

                    text.contentEditable =
                        "false";

                }

            }


            /*
                SHAPES
            */

            if(
                original.classList.contains(
                    "shape-object"
                )
            ){

                const height =
                    original.offsetHeight ||
                    parseFloat(
                        original.style.height
                    ) ||
                    70;

                saved.style.height =
                    Math.round(
                        height
                    ) +
                    "px";

            }


            /*
                Remove admin controls.
            */

            saved
            .querySelectorAll(
                ".object-controls,.resize-handle,.rotation-handle,.rotation-line"
            )
            .forEach(
                function(control){

                    control.remove();

                }
            );


            saved.classList.remove(
                "selected",
                "editing"
            );

        }
    );


    /*
        Remove contenteditable.
    */

    clone.removeAttribute(
        "contenteditable"
    );

    clone.removeAttribute(
        "spellcheck"
    );

    clone.removeAttribute(
        "id"
    );


    /*
        Create saved canvas.
    */

    const canvas =
        document.createElement(
            "div"
        );

    canvas.className =
        "ogcons-note-canvas";


    /*
        IMPORTANT:

        The canvas has a fixed logical height
        large enough for the editor.

        Normal text remains inside it.

        Design objects use their saved
        top position.
    */

    canvas.style.position =
        "relative";

    canvas.style.width =
        "100%";

    canvas.style.maxWidth =
        "100%";

    canvas.style.minHeight =
        Math.max(
            editor.scrollHeight,
            700
        ) +
        "px";

    canvas.style.boxSizing =
        "border-box";


    /*
        Put the note content inside canvas.
    */

    canvas.innerHTML =
        clone.innerHTML;


    /*
        Add responsive CSS directly to
        the saved note.
    */

    const style =
        document.createElement(
            "style"
        );


    style.textContent = `

        .ogcons-note-canvas {
            position: relative;
            width: 100%;
            max-width: 100%;
            min-height: 700px;
            box-sizing: border-box;
            overflow: visible;
        }

        .ogcons-note-canvas img {
            max-width: 100%;
            height: auto;
        }

        .ogcons-note-canvas .design-object {
            position: absolute;
            box-sizing: border-box;
        }

        .ogcons-note-canvas .image-object {
            position: absolute;
        }

        .ogcons-note-canvas .image-object img {
            width: 100% !important;
            max-width: 100% !important;
            height: auto !important;
            display: block;
        }

        .ogcons-note-canvas .text-object {
            position: absolute;
            max-width: 90%;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .ogcons-note-canvas .shape-object {
            position: absolute;
        }

        .ogcons-note-canvas .object-controls,
        .ogcons-note-canvas .resize-handle,
        .ogcons-note-canvas .rotation-handle,
        .ogcons-note-canvas .rotation-line {
            display: none !important;
        }

        @media(max-width:700px){

            .ogcons-note-canvas {
                width:100% !important;
                max-width:100% !important;
                overflow:visible;
            }

            .ogcons-note-canvas .text-object {
                max-width:92%;
            }

            .ogcons-note-canvas .image-object img {
                max-width:100% !important;
                height:auto !important;
            }

        }

    `;


    canvas.prepend(
        style
    );


    return canvas.outerHTML;

}


/* =====================================================
   SAVE NOTE
===================================================== */

async function saveNote(){

    const course =
        document.getElementById(
            "course"
        ).value.trim();

    const topic =
        document.getElementById(
            "topic"
        ).value.trim();

    const title =
        document.getElementById(
            "title"
        ).value.trim();


    if(!course){

        showStatus(
            "Please select a course.",
            "error"
        );

        return;

    }


    if(!topic){

        showStatus(
            "Please select a topic.",
            "error"
        );

        return;

    }


    if(!title){

        showStatus(
            "Please enter a note title.",
            "error"
        );

        return;

    }


    exitTextEditing();

    selectObject(
        null
    );


    const content =
        prepareHTMLForSaving();


    try{

        let result;


        if(editingNoteId){

            result =
                await supabaseClient
                .from("notes")
                .update({

                    course:course,

                    topic:topic,

                    title:title,

                    content:content,

                    updated_at:
                        new Date()
                        .toISOString()

                })
                .eq(
                    "id",
                    editingNoteId
                );

        }
        else{

            result =
                await supabaseClient
                .from("notes")
                .insert({

                    course:course,

                    topic:topic,

                    title:title,

                    content:content

                });

        }


        if(result.error){

            throw result.error;

        }


        showStatus(
            editingNoteId
            ? "Note updated successfully."
            : "Note saved successfully.",
            "success"
        );


        clearEditor();

        loadNotes();

    }
    catch(error){

        console.error(
            error
        );

        showStatus(
            "Error saving note: " +
            error.message,
            "error"
        );

    }

}


/* =====================================================
   LOAD NOTES
===================================================== */

async function loadNotes(){

    try{

        const {
            data,
            error
        } =
            await supabaseClient
            .from("notes")
            .select("*")
            .order(
                "created_at",
                {
                    ascending:false
                }
            );


        if(error){

            throw error;

        }


        allNotes =
            data || [];


        displayNotes(
            allNotes
        );

    }
    catch(error){

        console.error(
            error
        );

        document.getElementById(
            "notesList"
        ).innerHTML =
            "<p>Unable to load notes.</p>";

    }

}


/* =====================================================
   DISPLAY NOTES
===================================================== */

function displayNotes(
    notes
){

    const list =
        document.getElementById(
            "notesList"
        );

    const count =
        document.getElementById(
            "noteCount"
        );


    count.textContent =
        notes.length +
        (
            notes.length === 1
            ? " note"
            : " notes"
        );


    list.innerHTML =
        "";


    if(!notes.length){

        list.innerHTML =
            "<p>No notes found.</p>";

        return;

    }


    notes.forEach(
        function(note){

            const card =
                document.createElement(
                    "div"
                );

            card.className =
                "note-card";


            const title =
                document.createElement(
                    "h3"
                );

            title.textContent =
                note.title ||
                "Untitled Note";


            const topic =
                document.createElement(
                    "div"
                );

            topic.className =
                "note-topic";

            topic.textContent =
                note.course +
                " • " +
                note.topic;


            const preview =
                document.createElement(
                    "div"
                );

            preview.className =
                "note-preview";

            preview.innerHTML =
                note.content || "";


            const actions =
                document.createElement(
                    "div"
                );

            actions.className =
                "note-actions";


            const edit =
                document.createElement(
                    "button"
                );

            edit.className =
                "edit-btn";

            edit.textContent =
                "Edit";

            edit.onclick =
                function(){

                    editNote(
                        note.id
                    );

                };


            const del =
                document.createElement(
                    "button"
                );

            del.className =
                "delete-btn";

            del.textContent =
                "Delete";

            del.onclick =
                function(){

                    deleteNote(
                        note.id
                    );

                };


            actions.appendChild(
                edit
            );

            actions.appendChild(
                del
            );


            card.appendChild(
                title
            );

            card.appendChild(
                topic
            );

            card.appendChild(
                preview
            );

            card.appendChild(
                actions
            );


            list.appendChild(
                card
            );

        }
    );

}


/* =====================================================
   SEARCH
===================================================== */

function searchNotes(){

    const search =
        document.getElementById(
            "searchNotes"
        )
        .value
        .trim()
        .toLowerCase();


    if(!search){

        displayNotes(
            allNotes
        );

        return;

    }


    const filtered =
        allNotes.filter(
            function(note){

                return (

                    (
                        note.title ||
                        ""
                    )
                    .toLowerCase()
                    .includes(
                        search
                    )

                    ||

                    (
                        note.course ||
                        ""
                    )
                    .toLowerCase()
                    .includes(
                        search
                    )

                    ||

                    (
                        note.topic ||
                        ""
                    )
                    .toLowerCase()
                    .includes(
                        search
                    )

                );

            }
        );


    displayNotes(
        filtered
    );

}


function clearSearch(){

    document.getElementById(
        "searchNotes"
    ).value =
        "";

    displayNotes(
        allNotes
    );

}


/* =====================================================
   EDIT NOTE
===================================================== */

function editNote(
    id
){

    const note =
        allNotes.find(
            function(item){

                return item.id === id;

            }
        );


    if(!note){
        return;
    }


    editingNoteId =
        note.id;


    document.getElementById(
        "course"
    ).value =
        note.course;


    document.getElementById(
        "course"
    ).dispatchEvent(
        new Event(
            "change"
        )
    );


    document.getElementById(
        "topic"
    ).value =
        note.topic;


    document.getElementById(
        "title"
    ).value =
        note.title || "";


    loadEditorContent(
        note.content || ""
    );


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });


    showStatus(
        "Editing note. Make your changes and click Save Note.",
        "success"
    );

}


/* =====================================================
   LOAD EDITOR CONTENT
===================================================== */

function loadEditorContent(
    html
){

    const editor =
        getEditor();


    editor.innerHTML =
        html;


    /*
        Reconnect loaded design objects.
    */

    const objects =
        editor.querySelectorAll(
            ".design-object"
        );


    objects.forEach(
        function(object){

            if(
                !object.dataset.objectId
            ){

                object.dataset.objectId =
                    "object-" +
                    (++objectCounter);

            }


            makeObjectInteractive(
                object
            );


            const text =
                object.querySelector(
                    ".text-content"
                );


            if(text){

                text.contentEditable =
                    "false";

            }

        }
    );

}


/* =====================================================
   DELETE NOTE
===================================================== */

async function deleteNote(
    id
){

    const confirmed =
        confirm(
            "Are you sure you want to delete this note?"
        );


    if(!confirmed){
        return;
    }


    try{

        const {
            error
        } =
            await supabaseClient
            .from("notes")
            .delete()
            .eq(
                "id",
                id
            );


        if(error){

            throw error;

        }


        showStatus(
            "Note deleted successfully.",
            "success"
        );


        if(
            editingNoteId === id
        ){

            clearEditor();

        }


        loadNotes();

    }
    catch(error){

        console.error(
            error
        );

        showStatus(
            "Error deleting note: " +
            error.message,
            "error"
        );

    }

}


/* =====================================================
   CLEAR
===================================================== */

function clearEditor(){

    editingNoteId =
        null;

    selectedObject =
        null;

    exitTextEditing();


    document.getElementById(
        "course"
    ).value =
        "";


    document.getElementById(
        "topic"
    ).innerHTML =
        '<option value="">Select Topic</option>';


    document.getElementById(
        "title"
    ).value =
        "";


    getEditor().innerHTML =
        "";


    document.getElementById(
        "previewBox"
    ).style.display =
        "none";

}


/* =====================================================
   STATUS
===================================================== */

function showStatus(
    message,
    type
){

    const status =
        document.getElementById(
            "status"
        );


    status.textContent =
        message;

    status.className =
        type;


    setTimeout(
        function(){

            status.className =
                "";

        },
        4000
    );

}


/* =====================================================
   PREVIEW
===================================================== */

function showPreview(){

    exitTextEditing();

    selectObject(
        null
    );


    const html =
        prepareHTMLForSaving();


    document.getElementById(
        "previewContent"
    ).innerHTML =
        html;


    document.getElementById(
        "previewBox"
    ).style.display =
        "block";


    document.getElementById(
        "previewBox"
    ).scrollIntoView({
        behavior:"smooth"
    });

}


function closePreview(){

    document.getElementById(
        "previewBox"
    ).style.display =
        "none";

}


/* =====================================================
   UNDO / REDO
===================================================== */

function undoEdit(){

    document.execCommand(
        "undo"
    );

    getEditor().focus();

}


function redoEdit(){

    document.execCommand(
        "redo"
    );

    getEditor().focus();

}


/* =====================================================
   SAVE SELECTION
===================================================== */

getEditor().addEventListener(
    "keyup",
    function(){

        saveSelection();

    }
);


getEditor().addEventListener(
    "mouseup",
    function(){

        saveSelection();

    }
);


/* =====================================================
   ESCAPE
===================================================== */

document.addEventListener(
    "keydown",
    function(event){

        if(
            event.key === "Escape"
        ){

            exitTextEditing();

        }

    }
);


/* =====================================================
   START
===================================================== */

loadNotes();

</script>

