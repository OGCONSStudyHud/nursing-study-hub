function enterTextEditing(
    object
){

    exitTextEditing();

    object.classList.add(
        "editing"
    );

    const text =
        object.querySelector(
            ".text-content"
        );

    if(!text){
        return;
    }

    text.contentEditable =
        "true";

    text.focus();

    placeCaretAtEnd(
        text
    );

}


function placeCaretAtEnd(
    element
){

    const range =
        document.createRange();

    range.selectNodeContents(
        element
    );

    range.collapse(
        false
    );

    const selection =
        window.getSelection();

    selection.removeAllRanges();

    selection.addRange(
        range
    );

}


function exitTextEditing(){

    document
    .querySelectorAll(
        ".text-object.editing"
    )
    .forEach(
        function(object){

            object.classList.remove(
                "editing"
            );

            const text =
                object.querySelector(
                    ".text-content"
                );

            if(text){

                text.contentEditable =
                    "false";

            }

        }
    );

}


