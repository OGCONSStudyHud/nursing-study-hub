                🔗
            </button>

            <button onclick="insertTable()">
                Table
            </button>

            <button onclick="addImage()">
                🖼 Image
            </button>

            <button onclick="addImageByURL()">
                🌐 Image URL
            </button>

            <button onclick="addTextBox()">
                T Text
            </button>

