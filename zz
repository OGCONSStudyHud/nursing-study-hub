/* =====================================================
   DRAGGING
===================================================== */

function makeObjectInteractive(
    object
){

    object.addEventListener(
        "mousedown",
        function(event){

            if(
                event.target.closest(
                    ".object-controls"
                )
            ){
                return;
            }

            if(
                event.target.closest(
                    ".resize-handle"
                )
            ){
                return;
            }

            if(
                event.target.closest(
                    ".rotation-handle"
                )
            ){
                return;
            }


            selectObject(
                object
            );


            if(
                object.classList.contains(
                    "text-object"
                ) &&
                object.classList.contains(
                    "editing"
                )
            ){

                return;

            }


            startDrag(
                event,
                object
            );

        }
    );


    object.addEventListener(
        "dblclick",
        function(event){

            if(
                object.classList.contains(
                    "text-object"
                )
            ){

                event.preventDefault();

                event.stopPropagation();

                enterTextEditing(
                    object
                );

            }

        }
    );

}


function startDrag(
    event,
    object
){

    if(
        event.button !== 0
    ){
        return;
    }

    event.preventDefault();

    const editor =
        getEditor();

    const editorRect =
        editor.getBoundingClientRect();

    const objectRect =
        object.getBoundingClientRect();


    dragData = {

        object:object,

        startMouseX:event.clientX,

        startMouseY:event.clientY,

        startLeft:
            objectRect.left -
            editorRect.left +
            editor.scrollLeft,

        startTop:
            objectRect.top -
            editorRect.top +
            editor.scrollTop

    };


    document.addEventListener(
        "mousemove",
        dragMove
    );

    document.addEventListener(
        "mouseup",
        stopDrag
    );

}


function dragMove(
    event
){

    if(!dragData){
        return;
    }

    const dx =
        event.clientX -
        dragData.startMouseX;

    const dy =
        event.clientY -
        dragData.startMouseY;

    let left =
        dragData.startLeft +
        dx;

    let top =
        dragData.startTop +
        dy;


    left =
        Math.max(
            0,
            left
        );

    top =
        Math.max(
            0,
            top
        );


    dragData.object.style.left =
        left +
        "px";

    dragData.object.style.top =
        top +
        "px";

}


function stopDrag(){

    dragData =
        null;

    document.removeEventListener(
        "mousemove",
        dragMove
    );

    document.removeEventListener(
        "mouseup",
        stopDrag
    );

}


/* =====================================================
   RESIZE
===================================================== */

function startResize(
    event,
    object
){

    event.preventDefault();

    event.stopPropagation();

    const rect =
        object.getBoundingClientRect();

    resizeData = {

        object:object,

        startX:event.clientX,

        startY:event.clientY,

        startWidth:rect.width,

        startHeight:rect.height

    };


    document.addEventListener(
        "mousemove",
        resizeMove
    );

    document.addEventListener(
        "mouseup",
        stopResize
    );

}


function resizeMove(
    event
){

    if(!resizeData){
        return;
    }

    const dx =
        event.clientX -
        resizeData.startX;

    const dy =
        event.clientY -
        resizeData.startY;

    const object =
        resizeData.object;

    let width =
        resizeData.startWidth +
        dx;

    let height =
        resizeData.startHeight +
        dy;


    width =
        Math.max(
            80,
            width
        );

    height =
        Math.max(
            40,
            height
        );


    object.style.width =
        width +
        "px";


    if(
        !object.classList.contains(
            "text-object"
        )
    ){

        object.style.height =
            height +
            "px";

    }

}


function stopResize(){

    resizeData =
        null;

    document.removeEventListener(
        "mousemove",
        resizeMove
    );

    document.removeEventListener(
        "mouseup",
        stopResize
    );

}


/* =====================================================
   ROTATION
===================================================== */

function getRotation(
    object
){

    const transform =
        object.style.transform;

    const match =
        transform.match(
            /rotate\((-?\d+(?:\.\d+)?)deg\)/
        );

    return match
        ? parseFloat(match[1])
        : 0;

}


function rotateObject(
    object,
    amount
){

    const current =
        getRotation(
            object
        );

    object.style.transform =
        "rotate(" +
        (
            current +
            amount
        ) +
        "deg)";

}


function startRotate(
    event,
    object
){

    event.preventDefault();

    event.stopPropagation();

    const rect =
        object.getBoundingClientRect();

    const centerX =
        rect.left +
        rect.width / 2;

    const centerY =
        rect.top +
        rect.height / 2;


    const startAngle =
        Math.atan2(
            event.clientY -
            centerY,

            event.clientX -
            centerX
        ) *
        180 /
        Math.PI;


    rotateData = {

        object:object,

        centerX:centerX,

        centerY:centerY,

        startAngle:startAngle,

        startRotation:
            getRotation(
                object
            )

    };


    document.addEventListener(
        "mousemove",
        rotateMove
    );

    document.addEventListener(
        "mouseup",
        stopRotate
    );

}


function rotateMove(
    event
){

    if(!rotateData){
        return;
    }

    const angle =
        Math.atan2(
            event.clientY -
            rotateData.centerY,

            event.clientX -
            rotateData.centerX
        ) *
        180 /
        Math.PI;


    const rotation =
        rotateData.startRotation +
        angle -
        rotateData.startAngle;


    rotateData.object.style.transform =
        "rotate(" +
        rotation +
        "deg)";

}


function stopRotate(){

    rotateData =
        null;

    document.removeEventListener(
        "mousemove",
        rotateMove
    );

    document.removeEventListener(
        "mouseup",
        stopRotate
    );

}


